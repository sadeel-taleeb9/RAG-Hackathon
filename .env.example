# OWNER: Partner 2 — Full-Stack & Integration Engineer
# Copy to .env (`cp .env.example .env`) and fill in real values locally.
# .env is git-ignored. NEVER commit a real key. Placeholder values only here.

# ---------------------------------------------------------------------------
# Mode: "mock" = UI with simulated answers (no key, no index needed)
#       "real" = full RAG pipeline (needs LLM_API_KEY and a built index)
# ---------------------------------------------------------------------------
RAG_MODE=mock

# ---------------------------------------------------------------------------
# LLM — any OpenAI-compatible endpoint. Pick ONE preset and set the key.
#   OpenAI:      LLM_BASE_URL=            LLM_MODEL=gpt-4o-mini
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
#                LLM_MODEL=<a model id listed in your Groq console>
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#                LLM_MODEL=<provider/model id from openrouter.ai/models>
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                LLM_MODEL=<a Gemini model id from Google AI Studio>
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
# Check the provider's docs for current model ids before the demo.
# ---------------------------------------------------------------------------
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Documents and index (relative paths are resolved from the repository root)
# ---------------------------------------------------------------------------
DOCS_DIR=data/university_docs
INDEX_DIR=storage/index
# pymupdf | pypdf — choose with `python -m rag.ingest --compare` (golden checks)
PDF_EXTRACTOR=pymupdf

# ---------------------------------------------------------------------------
# Chunking (characters). Rebuild the index after changing these.
# ---------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Embeddings (multilingual Arabic + English). Rebuild the index after changing.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Retrieval
# MIN_SIMILARITY: placeholder. Calibrate on tests/questions.json (see
# rag/retriever.py) and replace this comment with how the value was measured.
# ---------------------------------------------------------------------------
TOP_K=5
MIN_SIMILARITY=0.80

LOG_LEVEL=INFO
